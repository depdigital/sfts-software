// SFTS Rule Pack v2 (JSONC)
//
// This is the competition-rule source of truth. Change values only between
// matches, retain valid JSON syntax, and load the finished file through RULES.
// Both // line comments and /* block comments */ are supported by SFTS.
{
  "schemaVersion": 2,

  // Identity recorded with every completed match for traceability.
  "ruleset": {
    "id": "sfts-current",
    "name": "SFTS Default Rules",
    "federation": "WTF",
    "ruleVersion": "2026.1",
    "effectiveFrom": null,
    "source": "Built-in SFTS rules"
  },

  // These are software features this pack expects. Do not add unknown names:
  // unsupported capabilities make the pack fail safely instead of guessing.
  "compatibility": {
    "minimumSoftwareVersion": "3.0.0",
    "requiredCapabilities": [
      "BEST_OF_N_ROUNDS",
      "FINAL_SCORE",
      "POINT_GAP",
      "ROUND_GAMJEOM_LIMIT",
      "MATCH_GAMJEOM_LIMIT",
      "MAJORITY_VOTE",
      "TECHNICAL_COMBINATION",
      "KYESHI_MANUAL_DECISION",
      "GOLDEN_ROUND",
      "SUPERIORITY_DECISION",
      "MANUAL_MATCH_DECISIONS",
      "DYNAMIC_BREAK_DURATION",
      "SINGLE_ELIMINATION",
      "TOURNAMENT_PLACEMENTS",
      "TOURNAMENT_DIVISIONS",
      "RULE_PACK_V2"
    ]
  },

  "match": {
    // BEST_OF_N_ROUNDS is supported for 1-15 rounds. Rounds required to win
    // must be more than half of the total number of regulation rounds.
    "format": "BEST_OF_N_ROUNDS",
    "rounds": 3,
    "roundsRequiredToWin": 2,
    "roundDurationSeconds": 60,
    "minimumRoundDurationSeconds": 1,
    "maximumRoundDurationSeconds": 3600,

    // The default applies first. Each tier overrides it at and above its
    // minimum round duration. Add tiers in ascending threshold order.
    "breakDurationPolicy": {
      "defaultDurationSeconds": 35,
      "tiers": [
        { "minimumRoundDurationSeconds": 120, "breakDurationSeconds": 60 }
      ]
    }
  },

  "scoring": {
    // Base points are the normal point buttons and remote scoring choices.
    "basePointValues": [1, 2, 3],
    "basePointLabels": {
      "1": "PUNCH",
      "2": "CHEST",
      "3": "HEAD"
    },
    // Include every normal and technical award value used below.
    "acceptedPointValues": [1, 2, 3, 4, 6],
    "technicalInput": {
      "enabled": true,
      "windowMilliseconds": 1000,
      // Technical is registered only when it is combined with one of these
      // base-point buttons inside the time window.
      "eligibleBasePoints": [2, 3],
      "pointsByBasePoints": {
        "2": 4,
        "3": 6
      }
    },
    // Set to 0 only when a Gam-jeom must not award an opponent point.
    "gamJeomPointValue": 1
  },

  "penalties": {
    "gamJeom": {
      "awardsPointToOpponent": true,
      // Reaching this count in one regulation round ends that round.
      "roundLossAt": 5,
      // Use null when there is no match-level limit. To use a cumulative PUN
      // limit, set a number here and set accumulateAcrossRounds to true.
      "matchLossAt": null,
      "accumulateAcrossRounds": false
    }
  },

  "decisions": {
    "pointGap": {
      "enabled": true,
      "difference": 15,
      "appliesToRounds": [1, 2, 3]
    },
    "roundTie": { "type": "DRAW" },
    // The engine allows only these decision codes. Remove a code to hide it
    // from future referees; do not add a new code without engine support.
    "manualMatchDecisions": ["RSC", "WDR", "DSQ", "PUN", "DQB"],
    "winnerMethods": [
      "FINAL_SCORE",
      "POINT_GAP",
      "ROUND_GAMJEOM_LIMIT",
      "MATCH_GAMJEOM_LIMIT",
      "KYESHI_MANUAL_DECISION",
      "GOLDEN_POINTS",
      "SUPERIORITY",
      "REFEREE_STOPS_CONTEST",
      "WITHDRAWAL",
      "DISQUALIFICATION",
      "PUNITIVE_DECLARATION",
      "UNSPORTSMANLIKE_DISQUALIFICATION"
    ]
  },

  "tieBreak": {
    "afterRegulation": {
      "type": "GOLDEN_OR_WOO_SE_GIROK",
      // Keep one or both choices. An empty list is allowed only for
      // MANUAL_TOURNAMENT_RESOLUTION.
      "options": ["GOLDEN_ROUND", "WOO_SE_GIROK"]
    },
    "goldenRound": {
      "enabled": true,
      "durationSeconds": 60,
      "allowTimerEdit": true,
      "resetRegularScores": true,
      "scoreToWin": 2,
      "opponentGamJeomsToWin": 2,
      "onTimeExpiry": "SUPERIORITY",
      // Evaluated in this exact order. REFEREE_DECISION must remain last.
      "superiorityCriteria": [
        "GOLDEN_ROUND_PUNCH",
        "GOLDEN_ROUND_HIT_COUNT",
        "REGULATION_ROUNDS_WON",
        "FEWER_TOTAL_GAMJEOMS",
        "REFEREE_DECISION"
      ]
    },
    "wooSeGirok": {
      "enabled": true,
      "reasonCode": "SUP"
    }
  },

  "voting": {
    "mode": "STRICT_MAJORITY",
    "minimumActiveRemotes": 1,
    "maximumActiveRemotes": 4
  },

  "medical": {
    "kyeShi": {
      "enabled": true,
      "limitSeconds": 60,
      "onLimit": "MANUAL_WINNER"
    }
  },

  "tournament": {
    // Players are separated by division, gender, and their competition
    // category (weight category or manually assigned Sub Junior group).
    "format": "SINGLE_ELIMINATION",
    "groupBy": ["DIVISION", "GENDER", "CATEGORY"],
    "byes": "AUTOMATIC",
    "seeding": "SEEDED_RANDOM",

    "divisions": [
      {
        "id": "SENIOR",
        "label": "SENIOR",
        "ageLabel": "18 YEARS OLD AND ABOVE",
        "categoryType": "WEIGHT",
        "weightCategories": {
          "MALE": [
            { "name": "FINWEIGHT", "limit": "NOT EXCEEDING 54.0 KG" },
            { "name": "FLYWEIGHT", "limit": "OVER 54.1 TO 58.0 KG" },
            { "name": "BANTAMWEIGHT", "limit": "OVER 58.1 TO 63.0 KG" },
            { "name": "FEATHERWEIGHT", "limit": "OVER 63.1 TO 68.0 KG" },
            { "name": "LIGHTWEIGHT", "limit": "OVER 68.1 TO 74.0 KG" },
            { "name": "WELTERWEIGHT", "limit": "OVER 74.1 TO 80.0 KG" },
            { "name": "MIDDLEWEIGHT", "limit": "OVER 80.1 TO 87.0 KG" },
            { "name": "HEAVYWEIGHT", "limit": "OVER 87.1 KG" }
          ],
          "FEMALE": [
            { "name": "FINWEIGHT", "limit": "NOT EXCEEDING 46.0 KG" },
            { "name": "FLYWEIGHT", "limit": "OVER 46.1 TO 49.0 KG" },
            { "name": "BANTAMWEIGHT", "limit": "OVER 49.1 TO 53.0 KG" },
            { "name": "FEATHERWEIGHT", "limit": "OVER 53.1 TO 57.0 KG" },
            { "name": "LIGHTWEIGHT", "limit": "OVER 57.1 TO 62.0 KG" },
            { "name": "WELTERWEIGHT", "limit": "OVER 62.1 TO 67.0 KG" },
            { "name": "MIDDLEWEIGHT", "limit": "OVER 67.1 TO 74.0 KG" },
            { "name": "HEAVYWEIGHT", "limit": "OVER 74.1 KG" }
          ]
        }
      },
      {
        "id": "JUNIOR",
        "label": "JUNIOR",
        "ageLabel": "15-17 YEARS OLD",
        "categoryType": "WEIGHT",
        "weightCategories": {
          "MALE": [
            { "name": "FINWEIGHT", "limit": "NOT EXCEEDING 45.0 KG" },
            { "name": "FLYWEIGHT", "limit": "OVER 45.1 TO 48.0 KG" },
            { "name": "BANTAMWEIGHT", "limit": "OVER 48.1 TO 51.0 KG" },
            { "name": "FEATHERWEIGHT", "limit": "OVER 51.1 TO 55.0 KG" },
            { "name": "LIGHTWEIGHT", "limit": "OVER 55.1 TO 59.0 KG" },
            { "name": "WELTERWEIGHT", "limit": "OVER 59.1 TO 63.0 KG" },
            { "name": "LT MIDDLEWEIGHT", "limit": "OVER 63.1 TO 68.0 KG" },
            { "name": "MIDDLEWEIGHT", "limit": "OVER 68.1 TO 73.0 KG" },
            { "name": "LT HEAVYWEIGHT", "limit": "OVER 73.1 TO 78.0 KG" },
            { "name": "HEAVYWEIGHT", "limit": "OVER 78.1 KG" }
          ],
          "FEMALE": [
            { "name": "FINWEIGHT", "limit": "NOT EXCEEDING 42.0 KG" },
            { "name": "FLYWEIGHT", "limit": "OVER 42.1 TO 44.0 KG" },
            { "name": "BANTAMWEIGHT", "limit": "OVER 44.1 TO 46.0 KG" },
            { "name": "FEATHERWEIGHT", "limit": "OVER 46.1 TO 49.0 KG" },
            { "name": "LIGHTWEIGHT", "limit": "OVER 49.1 TO 52.0 KG" },
            { "name": "WELTERWEIGHT", "limit": "OVER 52.1 TO 55.0 KG" },
            { "name": "LT MIDDLEWEIGHT", "limit": "OVER 55.1 TO 59.0 KG" },
            { "name": "MIDDLEWEIGHT", "limit": "OVER 59.1 TO 63.0 KG" },
            { "name": "LT HEAVYWEIGHT", "limit": "OVER 63.1 TO 68.0 KG" },
            { "name": "HEAVYWEIGHT", "limit": "OVER 68.1 KG" }
          ]
        }
      },
      {
        "id": "CADET",
        "label": "CADET",
        "ageLabel": "12-14 YEARS OLD",
        "categoryType": "WEIGHT",
        "weightCategories": {
          "MALE": [
            { "name": "FINWEIGHT", "limit": "NOT EXCEEDING 33.0 KG" },
            { "name": "FLYWEIGHT", "limit": "OVER 33.1 TO 37.0 KG" },
            { "name": "BANTAMWEIGHT", "limit": "OVER 37.1 TO 41.0 KG" },
            { "name": "FEATHERWEIGHT", "limit": "OVER 41.1 TO 45.0 KG" },
            { "name": "LIGHTWEIGHT", "limit": "OVER 45.1 TO 49.0 KG" },
            { "name": "WELTERWEIGHT", "limit": "OVER 49.1 TO 53.0 KG" },
            { "name": "LT MIDDLEWEIGHT", "limit": "OVER 53.1 TO 57.0 KG" },
            { "name": "MIDDLEWEIGHT", "limit": "OVER 57.1 TO 61.0 KG" },
            { "name": "LT HEAVYWEIGHT", "limit": "OVER 61.1 TO 65.0 KG" },
            { "name": "HEAVYWEIGHT", "limit": "OVER 65.1 KG" }
          ],
          "FEMALE": [
            { "name": "FINWEIGHT", "limit": "NOT EXCEEDING 29.0 KG" },
            { "name": "FLYWEIGHT", "limit": "OVER 29.1 TO 33.0 KG" },
            { "name": "BANTAMWEIGHT", "limit": "OVER 33.1 TO 37.0 KG" },
            { "name": "FEATHERWEIGHT", "limit": "OVER 37.1 TO 41.0 KG" },
            { "name": "LIGHTWEIGHT", "limit": "OVER 41.1 TO 44.0 KG" },
            { "name": "WELTERWEIGHT", "limit": "OVER 44.1 TO 47.0 KG" },
            { "name": "LT MIDDLEWEIGHT", "limit": "OVER 47.1 TO 51.0 KG" },
            { "name": "MIDDLEWEIGHT", "limit": "OVER 51.1 TO 55.0 KG" },
            { "name": "LT HEAVYWEIGHT", "limit": "OVER 55.1 TO 59.0 KG" },
            { "name": "HEAVYWEIGHT", "limit": "OVER 59.1 KG" }
          ]
        }
      },
      {
        "id": "SUB_JUNIOR",
        "label": "SUB JUNIOR",
        "ageLabel": "11 YEARS OLD AND BELOW",
        "categoryType": "GROUP",
        "groups": [
          { "name": "GROUP 0", "ageLabel": "NOT OVER 9 YEARS OLD" },
          { "name": "GROUP 1", "ageLabel": "NOT OVER 10 YEARS OLD" },
          { "name": "GROUP 2", "ageLabel": "NOT OVER 11 YEARS OLD" },
          { "name": "GROUP 3", "ageLabel": "NOT OVER 11 YEARS OLD" },
          { "name": "GROUP 4", "ageLabel": "NOT OVER 11 YEARS OLD" },
          { "name": "GROUP 5", "ageLabel": "NOT OVER 11 YEARS OLD" }
        ]
      }
    ],

    "placements": {
      // When enabled, results are finalized as soon as a category final ends.
      // Set this to false only when placements will be managed outside SFTS.
      "enabled": true,

      // BOTH_SEMIFINAL_LOSERS awards two equal third places. No separate
      // bronze-medal bout is generated. This is the only supported policy.
      "thirdPlacePolicy": "BOTH_SEMIFINAL_LOSERS",

      // These labels appear in the on-screen, printable, and exported result
      // lists. The wording can be edited without changing tournament logic.
      "labels": {
        "first": "1ST",
        "second": "2ND",
        "third": "3RD"
      }
    }
  }
}

# Installed as /etc/sfts/sfts-scoreboard.env by deployment/install.sh.
# Do not place real secrets in this tracked example file.

PORT=8080
SFTS_KIOSK_MODE=true
SFTS_USB_IMPORT_ONLY=true

# Optional: pin USB imports to the UUID of the event flash drive.
# SFTS_USB_UUID=replace-with-the-usb-filesystem-uuid

# Optional: set a fixed host token for non-kiosk host connections.
# SFTS_HOST_TOKEN=replace-with-a-private-token

# Optional local Piper HTTP settings. Piper runs as a separate local service;
# generated WAV audio is kept in memory by the scoreboard and is not stored on disk.
# SFTS_TTS_ENGINE=piper
# SFTS_TTS_URL=http://127.0.0.1:5000/synthesize

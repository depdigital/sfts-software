[Unit]
Description=SFTS Taekwondo Scoring System
After=network-online.target sfts-piper.service
Wants=network-online.target sfts-piper.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=@SERVICE_USER@
Group=@SERVICE_GROUP@
WorkingDirectory=@PROJECT_DIR@
EnvironmentFile=-/etc/sfts/sfts-scoreboard.env
ExecStart=@NODE_BIN@ @PROJECT_DIR@/src/server.js
Restart=always
RestartSec=5
TimeoutStopSec=20
UMask=0027
NoNewPrivileges=true
CapabilityBoundingSet=
RestrictRealtime=true
ProtectKernelLogs=true
PrivateTmp=true
# USB status, mounting, and safe unmounting require visibility of removable devices.
PrivateDevices=false
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=multi-user.target
